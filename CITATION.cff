cff-version: 1.2.0
message: "If you use this software in academic work, please cite this repository and the associated Bachelor's Thesis."
title: "Training Visual Place Recognition Models Using View Overlap"
authors:
  - family-names: "Hernández Gimeno"
    given-names: "Manuel"
repository-code: "https://github.com/ManuelHernandezGimeno/vpr-overlap-training"
url: "https://github.com/ManuelHernandezGimeno/vpr-overlap-training"
license: MIT
keywords:
  - "visual place recognition"
  - "VPR"
  - "visual overlap"
  - "VGGT"
  - "MSLS"
  - "triplet loss"
  - "ResNet50"
  - "GeM"
abstract: "Research code for overlap-aware Visual Place Recognition training. The project estimates geometric overlap between MSLS positive image pairs using VGGT and studies continuous, binary and 2D overlap weighting in a ResNet50-GeM Triplet Loss pipeline."
